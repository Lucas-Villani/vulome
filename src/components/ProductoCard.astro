---
import { formatearPrecio } from "../lib/utils";
import type { Producto } from "../lib/productos";

const { producto } = Astro.props as { producto: Producto };
const inicial = producto.nombre.charAt(0).toUpperCase();
const fotos = (producto.imagenes ?? []).filter(Boolean);
const multiple = fotos.length > 1;
const medidas = (producto.medidas ?? []).filter((m) => m && m.medida && m.precio);
const tieneMedidas = medidas.length > 0;
const url = `/producto/${producto.slug}`;

let precioLabel: string;
if (tieneMedidas) {
  const precios = medidas.map((m) => m.precio);
  const min = Math.min(...precios);
  const max = Math.max(...precios);
  precioLabel = min === max ? formatearPrecio(min) : `${formatearPrecio(min)} – ${formatearPrecio(max)}`;
} else {
  precioLabel = formatearPrecio(producto.precio);
}
---

<div
  class="card"
  data-categoria={producto.categoria}
  data-nombre={producto.nombre.toLowerCase()}
>
  <div class="thumb">
    {multiple ? (
      <div class="carousel" data-count={fotos.length}>
        <div class="carousel-track">
          {fotos.map((f, i) => (
            <div class="slide">
              <img
                src={i === 0 ? f : undefined}
                data-src={f}
                alt={`${producto.nombre} — foto ${i + 1}`}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>
          ))}
        </div>
        <button class="car-btn car-prev" type="button" aria-label="Foto anterior">‹</button>
        <button class="car-btn car-next" type="button" aria-label="Foto siguiente">›</button>
        <div class="dots">
          {fotos.map((_, i) => (
            <button
              class={i === 0 ? "dot on" : "dot"}
              type="button"
              data-i={i}
              aria-label={`Ir a la foto ${i + 1}`}
            ></button>
          ))}
        </div>
      </div>
    ) : fotos.length === 1 ? (
      <img class="single" src={fotos[0]} alt={producto.nombre} loading="lazy" draggable="false" />
    ) : (
      <span class="thumb-ph" aria-hidden="true">{inicial}</span>
    )}
  </div>
  <div class="info">
    <div class="info-top">
      <span class="cat">{producto.categoria}</span>
      <h3 class="nombre">{producto.nombre}</h3>
      {tieneMedidas && (
        <div class="chips">
          {medidas.map((m) => <span class="chip">{m.medida}</span>)}
        </div>
      )}
    </div>
    <div class="pie">
      <span class="precio">{precioLabel}</span>
      <span class="ver">Ver producto <span class="ver-flecha">→</span></span>
    </div>
  </div>
  <a class="card-link" href={url} aria-label={`Ver ${producto.nombre}`}></a>
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px;
    color: var(--ink);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .card:hover {
    border-color: var(--ink);
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }
  /* Enlace que cubre toda la tarjeta (click en cualquier parte -> producto).
     Los controles del carrusel van por encima con z-index mayor. */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 10px;
    -webkit-user-drag: none;
  }
  .thumb {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border-radius: 4px;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
  }
  .thumb .single,
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease);
  }
  .card:hover .thumb .single,
  .card:hover .slide img {
    transform: scale(1.05);
  }
  .thumb-ph {
    font-family: var(--font-serif);
    font-size: 3rem;
    color: var(--ink-faint);
  }

  /* Carrusel */
  .carousel {
    position: absolute;
    inset: 0;
  }
  .carousel-track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 0.4s var(--ease);
    will-change: transform;
  }
  .slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }
  /* Degradé sutil abajo para dar contraste a los puntitos */
  .carousel::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.2), transparent);
    pointer-events: none;
    z-index: 2;
  }
  .car-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    border: 1px solid var(--line-2);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    transition: opacity 0.2s var(--ease), background 0.2s;
  }
  .car-prev { left: 8px; }
  .car-next { right: 8px; }
  .card:hover .car-btn { opacity: 1; }
  .car-btn:hover { background: #fff; }
  .dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 9px;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.55);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .dot.on {
    background: #fff;
    transform: scale(1.3);
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.7);
  }
  /* En pantallas táctiles las flechas quedan visibles (no hay hover) */
  @media (hover: none) {
    .car-btn { opacity: 0.9; }
  }

  .info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 17px;
  }
  .info-top {
    flex: 1;
  }
  .cat {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 9px;
  }
  .nombre {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.12;
    letter-spacing: -0.005em;
    min-height: 49px;
    text-wrap: balance;
  }
  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 13px;
  }
  .chip {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    border: 1px solid var(--line-2);
    padding: 5px 10px;
    border-radius: 4px;
  }
  .pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid var(--surface);
  }
  .precio {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--ink-mute);
    white-space: nowrap;
    transition: gap 0.2s var(--ease), color 0.2s;
  }
  .card:hover .ver {
    gap: 10px;
    color: var(--ink);
  }
  .ver-flecha {
    font-size: 13px;
  }
</style>

<script>
  function initCarousel(car: HTMLElement) {
    const track = car.querySelector<HTMLElement>(".carousel-track");
    const slides = Array.from(car.querySelectorAll<HTMLElement>(".slide"));
    const dots = Array.from(car.querySelectorAll<HTMLElement>(".dot"));
    const prev = car.querySelector<HTMLButtonElement>(".car-prev");
    const next = car.querySelector<HTMLButtonElement>(".car-next");
    const card = car.closest<HTMLElement>(".card");
    const thumb = car.closest<HTMLElement>(".thumb");
    const link = card?.querySelector<HTMLAnchorElement>(".card-link");
    if (!track || slides.length < 2) return;

    let i = 0;

    const load = (n: number) => {
      const img = slides[n]?.querySelector<HTMLImageElement>("img");
      if (img && !img.getAttribute("src") && img.dataset.src) {
        img.src = img.dataset.src;
      }
    };

    const update = () => {
      track.style.transform = `translateX(${-i * 100}%)`;
      dots.forEach((d, n) => d.classList.toggle("on", n === i));
      load(i);
      load(i + 1);
      load(i - 1);
    };

    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      update();
    };

    const stop = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
    };

    prev?.addEventListener("click", (e) => { stop(e); go(i - 1); });
    next?.addEventListener("click", (e) => { stop(e); go(i + 1); });
    dots.forEach((d, n) =>
      d.addEventListener("click", (e) => { stop(e); go(n); })
    );

    // Swipe táctil / arrastre: se mide sobre el enlace-overlay, pero solo
    // cuando el gesto arranca dentro de la imagen. Un swipe cambia la foto
    // y evita que se dispare la navegación al producto.
    let startX: number | null = null;
    let startY = 0;
    let swiped = false;

    link?.addEventListener("pointerdown", (e) => {
      const r = thumb?.getBoundingClientRect();
      if (!r || e.clientY < r.top || e.clientY > r.bottom) { startX = null; return; }
      startX = e.clientX;
      startY = e.clientY;
      swiped = false;
    });
    link?.addEventListener("pointermove", (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (!swiped && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
      }
    });
    link?.addEventListener("pointerup", (e) => {
      if (startX !== null && swiped) {
        const dx = e.clientX - startX;
        if (dx < 0) go(i + 1); else go(i - 1);
      }
      startX = null;
    });
    link?.addEventListener("click", (e) => {
      if (swiped) { e.preventDefault(); swiped = false; }
    });

    update();
  }

  document
    .querySelectorAll<HTMLElement>(".carousel[data-count]")
    .forEach(initCarousel);
</script>
